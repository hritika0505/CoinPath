# CoinPath Configuration Example
PORT=3000
NODE_ENV=development

# Optional SMS Gateway (Twilio)
# If omitted or left empty, CoinPath automatically operates in Safe Mock Mode,
# logging formatted alerts to the backend console and in-app Notification Inbox.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Database configuration
COINPATH_DB_PATH=coinpath.db
